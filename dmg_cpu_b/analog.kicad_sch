	(text "RVs have close to zero Ohm, if volume is 0 (~{ADJ}=0b111).\nRVs have a quarter of the Ohm value of one single resistor\ninside the MIXERs, if volume is 7 (~{ADJ}=0b000).\nThis means when exacly four of the five channels in a MIXER\nare enabled, then the total resistance across the MIXER is\nequal to the maximum resistance of an RV."
		(exclude_from_sim no)
		(at 198.12 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a55b82fd-c857-4f99-a2e2-485b71c29f93")
	)
	(text "3V"
		(exclude_from_sim no)
		(at 115.57 69.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a8576d4a-406c-46da-b48d-4d628e5ea32b")
	)
	(text "2.2V"
		(exclude_from_sim no)
		(at 224.79 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b779186b-92d9-4cd9-bd50-099a2efb9842")
	)
	(text "Like the AMPs behind the DACs, the final output AMPs are\nnon-inverting, and map lineary 1:1 when their input is\nbetween 0.7V and 4.1V."
		(exclude_from_sim no)
		(at 298.45 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c28cbbb6-9b06-4f94-ab5e-21f09820fa91")
	)
	(text "DACs output 0.7V-3.7V in 0.2V steps, if enabled.\n(5V if disabled.)\n\nAMPs are linear in that range and pass voltage through 1:1."
		(exclude_from_sim no)
		(at 134.62 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cc930649-3241-42be-86dd-e2a0247ca84f")
	)
	(text "Pin 61"
		(exclude_from_sim no)
		(at 168.91 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "f495c791-0422-4729-8636-65be7a37ac3b")
	)
