	(text "DBUS_BRIDGE pulls both sides (A and B) high when ~{PCH} is low.\nWhen ~{PCH} is high, it behaves like a latch. Whenever one side\ngets pulled low, DBUS_BRIDGE actively pulls both sides low until\n~{PCH} goes low again."
		(exclude_from_sim no)
		(at 186.69 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce11c35a-bd41-46ef-b34f-f9f4640a0153")
	)
