# Helper cell for defining the I/O ports of the CPU
# -------------------------------------------------

cell port:port virtual;

type port d[0]:inout d[1]:inout d[2]:inout d[3]:inout d[4]:inout d[5]:inout d[6]:inout d[7]:inout
